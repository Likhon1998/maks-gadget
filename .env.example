APP_NAME="Maks Gadget"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Seed demo catalog / CMS content with `php artisan db:seed`
# local → demo ON by default | production → demo OFF by default
# Force either way: SEED_DEMO=true or SEED_DEMO=false
SEED_DEMO=true

# Bootstrap admin (ProductionSeeder). Required on production if seeding.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@maksgadget.com
ADMIN_PASSWORD=12345678

SHOP_NAME="Maks Gadget"
SHOP_EMAIL=support@maksgadget.com
SHOP_PHONE="+880 1712-345678"
SHOP_ADDRESS="Gulshan 1, Dhaka 1212, Bangladesh"

# Shown as “Powered by …” on website, admin, POS, and receipts
POWERED_BY=Bynnas
POWERED_BY_URL=https://bynnas.com

APP_TIMEZONE=Asia/Dhaka
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: set SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# cPanel/LiteSpeed only: real web-visible storage folder (no symlink)
# PUBLIC_STORAGE_ROOT=/home/akhitele/public_html/storage
PUBLIC_STORAGE_ROOT=

VITE_APP_NAME="${APP_NAME}"
